# Paths default to ./data (replaced by the graders' copy). Inside Docker they are remapped to /app/data.
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db
# YYYY-MM-DD. Leave empty to use the system date.
APP_TODAY=2026-03-01
# LLM Provider: google | anthropic | openai | mock
LLM_PROVIDER=google
# Provider API keys (set the key for your provider; never commit real keys)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LOG_LEVEL=INFO
# Optional extra log file (console is always on). PII is scrubbed from both.
LOG_FILE=
